<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}
				Hobbies
			{% endblock %}
		</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/lumen/bootstrap.min.css">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
		<link rel="stylesheet" href="/assets/css/style.css">
		 {% block css %}{% endblock %}
	</head>
	<body>

		<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
			<div class="container-fluid px-4">
				<a class="navbar-brand" href="/">HobbyMatch</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarSupportedContent">
					<ul class="navbar-nav me-auto mb-2 mb-lg-0">
						<li class="nav-item">
							<a class="nav-link active" aria-current="page" href="/">Accueil</a>
						</li>
						{% if session.login is defined %}
							<li class="nav-item">
								<a class="nav-link" href="/AdminHobby/list">Admin List</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="/AdminHobby/add">Admin Add</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="/Hobby/fixtures">Fixtures</a>
							</li>
						{% endif %}
					</ul>
					<form class="d-flex" role="search">
						<input class="form-control" type="search" placeholder="Search" aria-label="Search">
						<button class="btn btn-outline-light ms-1" type="submit">Search</button>
					</form>
					<div>
						{% if session.login is defined %}
							<a class="btn btn-danger ms-2 mt-1 mt-xl-0" href="/User/logout" role="button">Log OUT</a>
						{% else %}
							<a class="btn btn-success ms-2 mt-1 mt-xl-0" href="/User/login" role="button">Log IN</a>
						{% endif %}
					</div>
				</div>
			</div>
		</nav>

		<div class="container mt-4"> {% block body %}{% endblock %}

			</div>

			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
			{% block javascript %}{% endblock %}

		</body>
	</html>
